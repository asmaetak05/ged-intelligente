# ----------------------------------------------------------------------------
# Clé API OpenAI — active le mode "IA Avancé" (optionnel)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# URL de la base de données (T1.2 — bascule auto SQLite/PostgreSQL)
# ----------------------------------------------------------------------------
# Valeur par défaut : SQLite local à la racine du projet.
# Pour basculer sur PostgreSQL (Docker ou instance externe), commenter la
# ligne SQLite et décommenter la ligne PostgreSQL ci-dessous.
#
# IMPORTANT : ne jamais commiter le fichier .env réel (gitignoreé).
#             Ce fichier .env.example sert de template.

# --- Dev local (POC) ---
DATABASE_URL=sqlite:///./ged.db

# --- Production (Docker) ---
# DATABASE_URL=postgresql://admin:password@localhost:5432/ged_db
